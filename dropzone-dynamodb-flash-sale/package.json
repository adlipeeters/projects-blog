{
  "name": "dropzone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Serverless DynamoDB commerce backend built to survive a flash sale",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:watch": "vitest test/unit",
    "build": "node scripts/build.mjs",
    "deploy": "pnpm build && terraform -chdir=infra/envs/dev apply",
    "deploy:fn": "pnpm build && terraform -chdir=infra/envs/dev apply -target=module.health",
    "seed": "tsx scripts/seed.ts",
    "seed-stock": "tsx scripts/seed-stock.ts",
    "stock-report": "tsx scripts/stock-report.ts",
    "reset-catalog": "tsx scripts/reset-catalog.ts",
    "verify-stock": "tsx scripts/verify-stock.ts",
    "backfill": "tsx scripts/backfill-status-index.ts",
    "tf:fmt": "terraform fmt -check -recursive infra",
    "tf:validate": "terraform -chdir=infra/envs/dev validate",
    "tf:plan": "terraform -chdir=infra/envs/dev plan"
  },
  "dependencies": {
    "@aws-lambda-powertools/batch": "^2.12.0",
    "@aws-lambda-powertools/logger": "^2.12.0",
    "@aws-lambda-powertools/metrics": "^2.12.0",
    "@aws-lambda-powertools/tracer": "^2.12.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-eventbridge": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/util-dynamodb": "^3.700.0",
    "ulid": "^3.0.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "testcontainers": "^11.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
